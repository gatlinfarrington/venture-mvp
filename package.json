{
  "name": "venture-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && npm run lint:design && npm run validate:content",
    "lint:design": "stylelint \"app/**/*.css\" \"components/**/*.css\" --allow-empty-input && node scripts/design-check.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "stripe:sync-prices": "node scripts/stripe-sync-prices.mjs",
    "verify:prod": "bash scripts/verify-prod.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:hero": "node scripts/hero-loop-test.mjs",
    "test:hero:suite": "WIDTHS=suite node scripts/hero-loop-test.mjs",
    "test:hero:cold": "COLD_LOAD=1 node scripts/hero-loop-test.mjs",
    "test:lhci": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "gray-matter": "^4.0.3",
    "next": "16.4.0",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.55.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.8.3",
    "vitest": "^5.0.3"
  }
}
