{
  "name": "revenuesheet-addon",
  "version": "0.1.0",
  "private": true,
  "description": "RevenueSheet Google Sheets add-on (clasp-ready Apps Script)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "push": "npm run build && clasp push",
    "open": "clasp open",
    "login": "clasp login"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.99",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
