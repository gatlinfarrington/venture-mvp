# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Workspace Marketplace listing URL (placeholder until published)
NEXT_PUBLIC_INSTALL_URL=https://workspace.google.com/marketplace

# Stripe — use TEST keys locally and on preview. Swap to live keys only in production.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Stripe Price IDs (create products in Stripe Dashboard → copy IDs)
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_PRO_MONTHLY
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE_PRO_ANNUAL
STRIPE_PRICE_BUSINESS_MONTHLY=price_REPLACE_BUSINESS_MONTHLY
STRIPE_PRICE_BUSINESS_ANNUAL=price_REPLACE_BUSINESS_ANNUAL

# Live key placeholders (set in Vercel Production when ready — leave unset until then)
# STRIPE_SECRET_KEY_LIVE=sk_live_REPLACE_ME
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_REPLACE_ME
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_REPLACE_ME

# License storage: Upstash Redis (recommended on Vercel).
# Without these, the API falls back to a local JSON file under .data/ (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional shared secret the Sheets add-on sends when verifying licenses
LICENSE_API_SECRET=
