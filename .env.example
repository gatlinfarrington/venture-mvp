# Public site URL (no trailing slash). In production on Vercel, omit to fall back to
# https://${VERCEL_PROJECT_PRODUCTION_URL} (e.g. https://venture-mvp.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Workspace Marketplace listing. When unset, Install CTAs open launch-invite capture
# (never the generic Marketplace homepage).
# NEXT_PUBLIC_MARKETPLACE_URL=
# NEXT_PUBLIC_INSTALL_URL=

# Stripe — paste keys into Vercel to go live (see docs/GO-LIVE.md).
# Paid CTAs enable when NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is a real pk_test_/pk_live_ value.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Optional: fixed price IDs. If unset, prices are looked up/created by lookup_key
# (revenuesheet_pro_monthly, revenuesheet_pro_annual, revenuesheet_business_monthly,
# revenuesheet_business_annual). Or run: npm run stripe:sync-prices
# STRIPE_PRICE_PRO_MONTHLY=price_…
# STRIPE_PRICE_PRO_ANNUAL=price_…
# STRIPE_PRICE_BUSINESS_MONTHLY=price_…
# STRIPE_PRICE_BUSINESS_ANNUAL=price_…

# Owner-only diagnostics (keep off for public production)
# STRIPE_SHOW_ADMIN_BANNER=1
# STRIPE_ADMIN_TOKEN=long-random-string

# License storage: Upstash Redis (recommended on Vercel).
# Without these, the API falls back to a local JSON file under .data/ (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional shared secret the Sheets add-on sends when verifying licenses
# (also accepted as Bearer token for GET /api/admin/stripe-status)
LICENSE_API_SECRET=
